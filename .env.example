# Copy this file to .env and fill in your keys.
# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# Google AI Studio (Gemini): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama runs locally, no key needed. Default host below.
OLLAMA_API_BASE=http://localhost:11434

# Encrypts provider API keys that users opt to save (Settings -> Models).
# Without it, saving keys is refused and users enter them per session
# instead -- everything else still works. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing or losing it makes already-saved keys unreadable; users are then
# asked for them per session again, so treat it as a real secret.
ROUTER_SECRET_KEY=

# --- deployment only (ignored in local dev) ---------------------------------

# Hostname Caddy serves. No domain? Use sslip.io with your public IP, dots
# replaced by dashes: 129.146.1.2 -> 129-146-1-2.sslip.io
SITE_ADDRESS=

# Cheap tier model as a litellm string. Defaults to local Ollama. If Ollama
# isn't running (no `--profile ollama`), the cascade skips the cheap tier and
# starts at mid -- which on the built-in stack costs the same. Only set this
# to a model litellm can price; an unpriced model reports $0 and makes every
# saving figure a lie.
#   CHEAP_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct
CHEAP_MODEL=
# Mid and frontier are overridable the same way. gpt-oss-20b via OpenRouter
# prices ~2.3x below the same model on Groq and makes the judge call 2.5x
# cheaper. After changing any tier, run scripts/calibrate_builtin.py so the
# routing policy has real numbers for the new stack.
#   MID_MODEL=openrouter/openai/gpt-oss-20b
#   FRONTIER_MODEL=openrouter/deepseek/deepseek-r1
MID_MODEL=
FRONTIER_MODEL=

# How the cheap tier's answer is checked before it ships. `auto` uses the
# learned scorer (data/answer_scorer.joblib, from scripts/train_scorer.py)
# when it exists -- no judge call, so the cheap tier can actually undercut
# mid -- and the LLM judge otherwise. `judge` forces the judge. The scorer
# is trained on the default cheap model's confidence; retrain after changing
# CHEAP_MODEL (scripts/build_scorer_data.py, then train_scorer.py).
VERIFIER=auto

# OpenRouter: one key, many providers. https://openrouter.ai/keys
OPENROUTER_API_KEY=
