# Copy this file to .env and fill in your keys.

# --- the built-in stack needs these two -------------------------------------

# OpenRouter serves the cheap tier (Llama 3.1 8B), mid (Gemini 3.5 Flash) and
# frontier (DeepSeek R1) from one key. Needs a few dollars of credit; the
# free allowance is about a cent. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Groq runs the judge (gpt-oss-20b, ~$0.00004 per verdict; free tier is
# plenty). https://console.groq.com/keys
GROQ_API_KEY=

# Encrypts provider API keys that users opt to save (Settings -> Models).
# Without it, saving keys is refused and users enter them per session
# instead -- everything else still works. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing or losing it makes already-saved keys unreadable; users are then
# asked for them per session again, so treat it as a real secret.
ROUTER_SECRET_KEY=

# --- optional ---------------------------------------------------------------

# Google AI Studio, only if you point a tier at gemini/... directly. Note the
# free tier is 20 requests per day per model, which is why the built-in
# stack goes through OpenRouter. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama, only if CHEAP_MODEL is a local model. No key needed.
OLLAMA_API_BASE=http://localhost:11434

# Prompt caps: per signed-in account per UTC day, and per device for the
# signed-out demo at /try.
DAILY_PROMPT_LIMIT=10
DEMO_PROMPT_LIMIT=3

# --- the models ---------------------------------------------------------------
# Every tier takes any litellm model string. Defaults are the measured stack
# (README, "Strategy comparison"). After changing any of these, run
# scripts/calibrate_builtin.py so the routing policy has real numbers; if
# you change CHEAP_MODEL and want the learned gate, also rebuild it
# (scripts/build_scorer_data.py, then train_scorer.py). Only use models
# litellm can price -- an unpriced model reports $0 and every saving figure
# becomes fiction.
#
#   CHEAP_MODEL=ollama/llama3.2:3b            # local, free, slow; skipped if Ollama isn't running
#   MID_MODEL=groq/openai/gpt-oss-20b         # the first stack's mid: so cheap the cascade only tied it
CHEAP_MODEL=
MID_MODEL=
FRONTIER_MODEL=

# The model that judges cheap-tier answers. Default gpt-oss-20b on Groq.
# Keep it much cheaper than a mid answer: with the judge tied to the mid
# model the cascade's overhead scales with mid's price and it never wins.
JUDGE_MODEL=

# Reasoning effort. Provider-specific: Gemini needs "minimal" to stop
# thinking (720 reasoning tokens on a two-sentence answer otherwise); Groq's
# gpt-oss takes low/medium/high and rejects "minimal". Defaults: mid
# minimal, judge low. Set MID_REASONING_EFFORT to an empty value for the
# provider default.
MID_REASONING_EFFORT=minimal
JUDGE_REASONING_EFFORT=low

# How cheap-tier answers are checked: `judge` (default) sends every one to
# JUDGE_MODEL; `auto` puts the learned gate in front when a scorer trained
# for CHEAP_MODEL exists (data/answer_scorer.joblib). The gate only pays for
# itself when the judge is expensive relative to a cheap answer.
VERIFIER=judge

# --- deployment only (ignored in local dev) ---------------------------------

# Hostname Caddy serves. No domain? Use sslip.io with your public IP, dots
# replaced by dashes: 129.146.1.2 -> 129-146-1-2.sslip.io
SITE_ADDRESS=

# The OpenAI-compatible /v1/chat/completions endpoint needs an API key
# unless this is set; the local eval harness sets it. Never on a public box.
ALLOW_ANON_V1=
